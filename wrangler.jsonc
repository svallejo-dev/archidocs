// Cloudflare Workers static assets: solo sirve _site/, sin código de Worker.
// El Account ID llega por la variable de GitHub CLOUDFLARE_ACCOUNT_ID, no se versiona aquí.
{
  "name": "archidocs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./_site",
    "not_found_handling": "404-page"
  }
}
