{
  "name": "archidocs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Artifacts HTML/Markdown escritos con agentes LLM, versionados en git y publicados como sitio estático.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build/build.mjs --out _site",
    "preview": "node build/build.mjs --out _site && python3 -m http.server 8765 --bind 127.0.0.1 --directory _site"
  },
  "dependencies": {
    "github-markdown-css": "5.9.0",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-github-alerts": "1.0.1",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.2.0",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1"
  }
}
